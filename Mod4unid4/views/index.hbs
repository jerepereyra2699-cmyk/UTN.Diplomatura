<h1>{{title}}</h1>
{{#if conocido}}
   <p>Hola {{nombre}}</p>
     {{#if mayor}}
       <h1>Eres mayor de edad</h1>
     {{/if}}
     {{#unless mayor}}
       <h1>Eres menor de edad</h1>
     {{/unless}}
 <a href="/salir">Salir</a>
{{/if}}

{{#unless conocido}}
  <p>No te conozco: Ingresa tu nombre y tu edad</p>
  <form action="/ingresar" method="post">
  <label>Nombre: </label><input type="text" name="nombre"></p>
  <label>Edad: </label><input type="text" name="edad"></p>
  <button>Ingresar</button>
  
  </form>
{{/unless}}


